# Sourced by bin/* and scripts/*: per-user integration settings (bundle id prefix, signing identity).
# Personal values live OUTSIDE the repo in ${VA_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/voice-agent}/env.sh, e.g.
#   export VA_BUNDLE_PREFIX=com.example     # launchd labels / Alfred bundle id / helper bundle id prefix
#   export VA_SIGN_IDENTITY="Apple Development: Jane Doe (TEAMID1234)"
VA_CONFIG_DIR="${VA_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/voice-agent}"
# shellcheck disable=SC1091
[ -f "$VA_CONFIG_DIR/env.sh" ] && . "$VA_CONFIG_DIR/env.sh"
export VA_CONFIG_DIR
export VA_BUNDLE_PREFIX="${VA_BUNDLE_PREFIX:-local.voice-agent}"
