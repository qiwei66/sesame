# Sourced by bin/va and bin/va-index: per-user settings.
# Personal values live OUTSIDE the repo in ${VA_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/voice-agent}/env.sh, e.g.
#   export VA_NODE=/path/to/node            # if node is not on the default PATH
VA_CONFIG_DIR="${VA_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/voice-agent}"
# shellcheck disable=SC1091
[ -f "$VA_CONFIG_DIR/env.sh" ] && . "$VA_CONFIG_DIR/env.sh"
export VA_CONFIG_DIR
